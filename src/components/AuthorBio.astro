---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, avatar, bio, socialLinks } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
	<Image class="author-avatar" src={avatar} alt={`${name}'s avatar`} width={96} height={96} />
	<div class="author-details">
		<p class="eyebrow" id="author-heading">About the author</p>
		<h2>{name}</h2>
		<p>{bio}</p>
		{
			socialLinks.length > 0 && (
				<nav aria-label={`${name}'s social links`}>
					<ul class="social-links">
						{socialLinks.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noreferrer">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</div>
</section>

<style>
	.author-bio {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-avatar {
		flex: 0 0 auto;
		border-radius: 50%;
		box-shadow: var(--box-shadow);
	}
	.author-details h2 {
		margin: 0.1rem 0 0.5rem;
	}
	.author-details > p:not(.eyebrow) {
		margin: 0;
	}
	.eyebrow {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		font-weight: bold;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.social-links {
		display: flex;
		gap: 1rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 520px) {
		.author-bio {
			gap: 1rem;
		}
		.author-avatar {
			width: 72px;
			height: 72px;
		}
	}
</style>